{
  "description": "When a design or debugging skill loads, add when to research outside before choosing an approach.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/research_nudge.py\" || python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/research_nudge.py\" || py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/research_nudge.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
